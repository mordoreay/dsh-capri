{
    "name":  "dsh-capri",
    "version":  "1.5.3",
    "private":  true,
    "type":  "module",
    "description":  "Capri в окне DeepSeek Harness: кадры из её шейдера, тикер действий, панель с лицом и режим «нужно твоё решение»",
    "author":  "mordoreay",
    "license":  "SEE LICENSE IN LICENSE",
    "homepage":  "https://github.com/mordoreay/dsh-capri",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/mordoreay/dsh-capri"
                   },
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./assets/*":  "./assets/*"
                },
    "files":  [
                  "index.js",
                  "brain.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale",
                  "docs",
                  "icon.svg",
                  "assets",
                  "NOTICE.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-layout",
                                              "@deepseek-ai/dsh-client-ui-conversation",
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ]
                           }
            }
}